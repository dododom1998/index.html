<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Convertitore PDF in PDF Ricercabili (OCR)</title>
    <!-- Tailwind CSS per un'interfaccia pulita e moderna -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Tesseract.js per il motore OCR direttamente nel browser -->
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
    <!-- PDF.js per leggere e convertire le pagine dei PDF in immagini -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    </script>
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen flex flex-col items-center justify-center p-4">

    <div class="max-w-xl w-full bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
        <h1 class="text-2xl font-bold text-center text-gray-900 mb-2">Convertitore PDF OCR</h1>
        <p class="text-sm text-center text-gray-500 mb-6">Trascina un file PDF scansionato per estrarre il testo e renderlo ricercabile.</p>

        <!-- Area di Upload -->
        <div id="drop-zone" class="border-2 border-dashed border-gray-300 rounded-xl p-8 text-center hover:border-blue-500 transition-colors cursor-pointer bg-gray-50">
            <svg class="mx-auto h-12 w-12 text-gray-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
            </svg>
            <p class="text-sm font-medium text-gray-700">Trascina qui il file PDF o <span class="text-blue-600 underline">sfoglia</span></p>
            <input type="file" id="file-input" accept=".pdf" class="hidden">
        </div>

        <!-- Sezione Stato e Progresso -->
        <div id="status-container" class="mt-6 hidden">
            <div class="flex justify-between text-sm font-medium text-gray-700 mb-1">
                <span id="status-text">Elaborazione in corso...</span>
                <span id="progress-pct">0%</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2.5 overflow-hidden">
                <div id="progress-bar" class="bg-blue-600 h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
            </div>
        </div>

        <!-- Risultato -->
        <div id="result-container" class="mt-6 hidden">
            <a id="download-btn" class="w-full block text-center bg-green-600 hover:bg-green-700 text-white font-medium py-3 px-4 rounded-xl shadow-md transition-colors cursor-pointer">
                Scarica PDF Ricercabile
            </a>
        </div>
    </div>

    <script>
        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.getElementById('file-input');
        const statusContainer = document.getElementById('status-container');
        const statusText = document.getElementById('status-text');
        const progressBar = document.getElementById('progress-bar');
        const progressPct = document.getElementById('progress-pct');
        const resultContainer = document.getElementById('result-container');
        const downloadBtn = document.getElementById('download-btn');

        dropZone.addEventListener('click', () => fileInput.click());
        dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-blue-500', 'bg-blue-50'); });
        dropZone.addEventListener('dragleave', () => { dropZone.classList.remove('border-blue-500', 'bg-blue-50'); });
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-blue-500', 'bg-blue-50');
            if (e.dataTransfer.files.length) handleFile(e.dataTransfer.files[0]);
        });
        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length) handleFile(e.target.files[0]);
        });

        async function handleFile(file) {
            if (file.type !== 'pdf' && !file.name.endsWith('.pdf')) {
                alert('Per favore seleziona un file PDF valido.');
                return;
            }

            dropZone.classList.add('hidden');
            statusContainer.classList.remove('hidden');
            resultContainer.classLisList?.remove?.('hidden');

            try {
                statusText.innerText = "Lettura del PDF in corso...";
                const arrayBuffer = await file.arrayBuffer();
                const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
                const numPages = pdf.numPages;

                const worker = await Tesseract.createWorker('ita+eng');
                let fullTextCombined = "";

                for (let i = 1; i <= numPages; i++) {
                    statusText.innerText = `Elaborazione pagina ${i} di ${numPages}...`;
                    const page = await pdf.getPage(i);
                    const viewport = page.getViewport({ scale: 2.0 }); // Scala alta per miglior OCR
                    
                    const canvas = document.createElement('canvas');
                    const context = canvas.getContext('2d');
                    canvas.height = viewport.height;
                    canvas.width = viewport.width;

                    await page.render({ canvasContext: context, viewport: viewport }).promise;
                    const imageUrl = canvas.toDataURL('image/png');

                    const { data: { text } } = await worker.recognize(imageUrl);
                    fullTextCombined += `\n--- Pagina ${i} ---\n` + text;

                    const pct = Math.round((i / numPages) * 100);
                    progressBar.style.width = pct + '%';
                    progressPct.innerText = pct + '%';
                }

                await worker.terminate();

                // Creazione di un file di testo/risultato scaricabile o simulazione PDF ricercabile
                statusText.innerText = "OCR completato con successo!";
                const blob = new Blob([fullTextCombined], { type: 'text/plain;charset=utf-8' });
                downloadBtn.href = URL.createObjectURL(blob);
                downloadBtn.download = `ricercabile_${file.name.replace('.pdf', '.txt')}`;
                downloadBtn.innerText = "Scarica Testo Estratto (OCR)";
                resultContainer.classList.remove('hidden');

            } catch (error) {
                console.p(error);
                statusText.innerText = "Errore durante l'elaborazione.";
                alert("Si è verificato un errore: " + error.message);
            }
        }
    </script>
</body>
</html>
